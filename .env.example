# How the browser reaches the government APIs.
#   proxy    - route through the Vite dev server (default in `npm run dev`; sidesteps CORS entirely)
#   direct   - call api.usaspending.gov / api.fiscaldata.treasury.gov straight from the browser
#   snapshot - read pre-fetched JSON from /data (produced by `npm run ingest`); works fully offline
VITE_DATA_MODE=proxy

# Optional: override the upstream hosts (e.g. to point at your own caching proxy).
# VITE_USASPENDING_BASE=https://api.usaspending.gov
# VITE_FISCALDATA_BASE=https://api.fiscaldata.treasury.gov
