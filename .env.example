# How the browser reaches the government APIs.
#
#   direct   - the browser calls api.usaspending.gov / api.fiscaldata.treasury.gov
#              itself. Default for a production build: no proxy hop, no server
#              cost. Depends on those APIs sending permissive CORS headers.
#   proxy    - route through this app's own origin: the Vite dev server locally,
#              or the serverless functions in api/ on Vercel. Default in
#              `npm run dev`. Use in production only if direct mode is blocked.
#   snapshot - read pre-fetched JSON from /data (produced by `npm run ingest`);
#              works with no network at all.
VITE_DATA_MODE=proxy

# Optional: override the upstream hosts (e.g. to point at your own caching proxy).
# VITE_USASPENDING_BASE=https://api.usaspending.gov
# VITE_FISCALDATA_BASE=https://api.fiscaldata.treasury.gov
